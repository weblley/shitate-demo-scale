# Japanese translation for shitate demo scale.
msgid ""
msgstr ""
"Project-Id-Version: shitate demo scale 0.1.0\n"
"Language: ja\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"X-Domain: shitate-demo-scale\n"

msgid "Minor Second — 1.067"
msgstr "短2度 — 1.067"

msgid "Major Second — 1.125"
msgstr "長2度 — 1.125"

msgid "Minor Third — 1.2"
msgstr "短3度 — 1.2"

msgid "Major Third — 1.25"
msgstr "長3度 — 1.25"

msgid "Perfect Fourth — 1.333"
msgstr "完全4度 — 1.333"

msgid "Augmented Fourth — 1.414"
msgstr "増4度 — 1.414"

msgid "Perfect Fifth — 1.5"
msgstr "完全5度 — 1.5"

msgid "Golden Ratio — 1.618"
msgstr "黄金比 — 1.618"

msgid "Display / H1"
msgstr "Display / H1"

msgid "Huge / H2"
msgstr "Huge / H2"

msgid "Extra Large / H3"
msgstr "Extra Large / H3"

msgid "Large / H4"
msgstr "Large / H4"

msgid "Medium / Body"
msgstr "Medium / 本文"

msgid "Small / H6"
msgstr "Small / H6"

msgid "X-Small"
msgstr "X-Small"

msgid "XX-Small"
msgstr "XX-Small"

msgid "Try the type scale"
msgstr "タイプスケールを試す"

msgid "Typography Scale"
msgstr "タイポグラフィスケール"

msgid "Close"
msgstr "閉じる"

msgid "Changes apply to this page instantly and are remembered in your browser only. Nothing is saved on the site."
msgstr "変更はこのページに即時反映され、あなたのブラウザ内にだけ記憶されます。サイト側には何も保存されません。"

msgid "Scale ratio"
msgstr "スケール比率"

msgid "Bigger ratio = more contrast between headings (like typescale.com)."
msgstr "比率が大きいほど見出し間のコントラストが強くなります（typescale.com と同じ考え方）。"

msgid "Base size"
msgstr "基準サイズ"

msgid "Body text size. The whole scale is built from this."
msgstr "本文の文字サイズ。スケール全体はここから計算されます。"

msgid "Apply rounding to font sizes"
msgstr "フォントサイズにラウンドを適用"

msgid "Snaps every text step to even pixels (2px)."
msgstr "すべての文字段を偶数ピクセル（2px）にスナップします。"

msgid "Resulting sizes at this viewport"
msgstr "この画面幅での実サイズ"

msgid "Reset to theme settings"
msgstr "テーマの設定に戻す"

msgid "Done"
msgstr "完了"

msgid "Fixed sizes for small text"
msgstr "小さな文字の数値指定"

msgid "Sets Small / X-Small / XX-Small to 0.95rem / 0.8rem / 0.75rem instead of dividing by the ratio, which can make them too small to read."
msgstr "Small / X-Small / XX-Small を比率で割らず 0.95rem / 0.8rem / 0.75rem に固定します（比率で割ると小さすぎて読みにくくなる場合の対策）。"

msgid "Display"
msgstr "表示"

msgid "Launcher button"
msgstr "起動ボタン"

msgid "The \"Aa\" button and the Typography Scale modal appear on the front end while the shitate theme is active."
msgstr "「Aa」ボタンとタイポグラフィスケールのモーダルは、shitate テーマが有効な間フロントエンドに表示されます。"

msgid "Show the button only to logged-in users"
msgstr "ログイン時のみボタンを表示する"

msgid "Unchecked: every visitor can open the modal (demo-site behaviour). Checked: only logged-in users see the button — handy while a site is public but not yet meant as a demo."
msgstr "オフ: すべての訪問者がモーダルを開けます（デモサイト向け）。オン: ログイン中のユーザーにだけボタンを表示します（公開中だがまだデモとして見せたくないサイトに便利）。"

msgid "shitate demo scale"
msgstr "shitate demo scale"

msgid "The shitate theme is not active, so the button is currently hidden regardless of this setting."
msgstr "shitate テーマが有効でないため、この設定に関わらずボタンは現在表示されません。"

msgid "Settings"
msgstr "設定"

msgid "Auto — halfway between 1 and the main ratio"
msgstr "自動（1 とメイン比率の中間）"

msgid "Scale ratio on small screens"
msgstr "小さな画面での比率"

msgid "The ratio used at 375px wide. The scale eases from this to the main ratio by 1260px, so type and spacing tighten on phones without media queries."
msgstr "画面幅 375px で使う比率。1260px までにメイン比率へなめらかに変化し、メディアクエリなしでスマホでは文字も余白も引き締まります。"

msgid "You are logged in with theme-editing rights: you can write these values into the theme's Customizer settings for every visitor."
msgstr "テーマ編集権限でログイン中です。この値をテーマのカスタマイザー設定に書き込み、すべての訪問者に適用できます。"

msgid "Save to theme settings"
msgstr "テーマの設定として保存"

msgid "Saving…"
msgstr "保存中…"

msgid "Saved. Every visitor now gets this scale (the button turns back to the neutral state)."
msgstr "保存しました。以後すべての訪問者にこのスケールが適用されます（ボタンの変更マークは消えます）。"

msgid "Could not save. Reload the page and try again."
msgstr "保存できませんでした。ページを再読み込みしてもう一度お試しください。"
